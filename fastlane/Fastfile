default_platform(:ios)

APP_ID = "com.edgeless.tartanism"
TEAM_ID = "9BKHLSZVGF"
PROFILE_NAME = "com.edgeless.tartanism AppStore"
PROFILE_FILENAME = "Tartanism App Store Distribution.mobileprovision"
PROJECT = "ios/App/App.xcodeproj"
SCHEME = "App"
EXPORT_OPTIONS = File.expand_path("../exportOptions.plist")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_API_KEY_PATH"),
    in_house: false,
  )
end

platform :ios do
  desc "Fetch / create distribution provisioning profile for Tartanism"
  lane :certs do
    get_provisioning_profile(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      filename: "#{PROFILE_NAME}.mobileprovision",
      output_path: "./fastlane/profiles",
      platform: "ios",
    )
  end

  desc "Build a signed app-store IPA (no upload)"
  lane :archive_ipa do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Tartanism.ipa",
      clean: true,
      export_options: EXPORT_OPTIONS,
      xcargs: [
        "-allowProvisioningUpdates",
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE_NAME}'",
      ].join(" "),
    )
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    increment_build_number(xcodeproj: PROJECT)
    archive_ipa
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Push metadata + screenshots to the App Store listing (no submit, no binary)"
  lane :push_listing do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      submit_for_review: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Verify the editable App Store version is ready to submit"
  lane :verify_listing do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: ENV.fetch("ASC_API_KEY_PATH"),
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    ver = app.get_edit_app_store_version
    UI.message(">> version #{ver.version_string} state=#{ver.app_store_state}")
    build = ver.build
    if build
      full = Spaceship::ConnectAPI::Build.get(build_id: build.id, includes: "buildBetaDetail,betaBuildLocalizations")
      UI.message(">> build #{full.version} usesNonExemptEncryption=#{full.uses_non_exempt_encryption.inspect}")
    end
    begin
      ard = ver.fetch_age_rating_declaration
      UI.message(">> ageRatingDeclaration present=#{!ard.nil?}")
    rescue => e
      UI.message(">> ageRating fetch error: #{e.message}")
    end
    begin
      idfa = ver.fetch_idfa_declaration rescue nil
      UI.message(">> idfaDeclaration present=#{!idfa.nil?}")
    end
    begin
      info = app.fetch_edit_app_info
      UI.message(">> AppInfo state=#{info.app_info_state rescue info.state rescue 'n/a'}")
      pc = info.primary_category rescue nil
      sc = info.secondary_category rescue nil
      UI.message(">> primaryCategory=#{pc&.id || pc.inspect}  secondaryCategory=#{sc&.id || sc.inspect}")
      ard = info.fetch_age_rating_declaration rescue nil
      UI.message(">> AppInfo ageRatingDeclaration present=#{!ard.nil?}")
    rescue => e
      UI.message(">> AppInfo error: #{e.message}")
    end
  end

  desc "Submit current TestFlight build for App Store review"
  lane :release do
    deliver(
      api_key: asc_api_key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
    )
  end
end
